# Identity.API taban adresi (auth, hesap, şehir/ilçe referans verisi)
VITE_IDENTITY_API_URL=https://localhost:7214/api

# Donation.API taban adresi (kan talebi, bağış, hastane, profil, sohbet, bildirim)
VITE_DONATION_API_URL=https://localhost:7079/api

# Firebase Client SDK config (Firebase Console → Project Settings)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Web push için VAPID public key (Firebase Console → Cloud Messaging → Web Push certificates)
VITE_FIREBASE_VAPID_KEY=
